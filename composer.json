{
    "name": "buildwithsmk/laravel-tenancy",
    "description": "Lightweight multi-tenancy for Laravel: shared database by default, and upgrade any tenant to a dedicated database, Redis or storage.",
    "keywords": ["laravel", "tenancy", "multi-tenancy", "multi-tenant", "saas", "tenant", "database-per-tenant"],
    "license": "MIT",
    "type": "library",
    "homepage": "https://github.com/MSumon89/laravel-tenancy",
    "support": {
        "issues": "https://github.com/MSumon89/laravel-tenancy/issues",
        "source": "https://github.com/MSumon89/laravel-tenancy"
    },
    "require": {
        "php": "^8.2",
        "illuminate/cache": "^11.0|^12.0|^13.0",
        "illuminate/console": "^11.0|^12.0|^13.0",
        "illuminate/database": "^11.0|^12.0|^13.0",
        "illuminate/filesystem": "^11.0|^12.0|^13.0",
        "illuminate/http": "^11.0|^12.0|^13.0",
        "illuminate/routing": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "buildwithsmk/laravel-tenant-permission": "^1.0",
        "laravel/pint": "^1.13",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "pestphp/pest": "^3.0|^4.0"
    },
    "suggest": {
        "buildwithsmk/laravel-tenant-permission": "Tenant-scoped roles and permissions. Follows the current tenant automatically when both are installed."
    },
    "autoload": {
        "psr-4": {
            "BuildWithSmk\\Tenancy\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "BuildWithSmk\\Tenancy\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/pest",
        "format": "vendor/bin/pint"
    },
    "extra": {
        "laravel": {
            "providers": [
                "BuildWithSmk\\Tenancy\\TenancyServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
